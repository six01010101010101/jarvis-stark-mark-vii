# Copie este arquivo para ".env" e preencha os valores.
# Nunca compartilhe o arquivo .env (ele contém sua chave secreta).

# Obrigatório - gere gratuitamente em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Obrigatório - nome usado na saudação ("Boa noite, <nome>")
JARVIS_USER_NAME=

# Opcionais
GEMINI_MODEL=gemini-3.5-flash-lite
JARVIS_LANGUAGE=pt-BR
JARVIS_WAKE_WORD=jarvis
# Padrão: mensagens_salvas.txt na sua Área de Trabalho
JARVIS_TRANSCRIPTION_FILE=

# Integração Cloud Supabase (Opcional)
SUPABASE_URL=
SUPABASE_KEY=
